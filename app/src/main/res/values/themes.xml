<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LANMAN" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Optional: set default window background if needed -->
    </style>

    <style name="Theme.LANMAN.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation duration. -->
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.LANMAN</item>
    </style>
</resources>