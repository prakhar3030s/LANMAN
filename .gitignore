# ====================================================================
# Local Configuration & Sensitive Files (DO NOT COMMIT)
# ====================================================================
# Machine-specific SDK/signing paths and real signing credentials.
local.properties
keystore.properties
signing.properties
release.properties
secrets.properties
api_keys.properties
api-keys.properties

# Signing keys / certificates: never publish your private key material.
*.jks
*.keystore
*.bks
*.p12
*.pfx
*.p8
*.pk8
*.key
*.pem
*.der
*.cer
*.csr

# ====================================================================
# Environment Variable Files (never commit real values)
# ====================================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.example.*
!.env.*.example

# ====================================================================
# Cloud / Service Credentials
# ====================================================================
# Firebase/Google configs carry API keys and should be injected at build
# time (CI secret or local file), not checked in.
google-services.json
firebase-admin*.json
service-account*.json
service_account*.json
credentials*.json
secrets.json
secrets.xml

